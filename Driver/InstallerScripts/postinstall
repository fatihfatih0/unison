#!/bin/sh
# Register the signed HAL bundle by restarting the audio service once.
/usr/bin/killall coreaudiod 2>/dev/null || true
/bin/sleep 2
console_user=$(/usr/bin/stat -f %Su /dev/console)
if [ "$console_user" != "root" ] && [ "$console_user" != "loginwindow" ]; then
    console_uid=$(/usr/bin/id -u "$console_user")
    /bin/launchctl asuser "$console_uid" /usr/bin/sudo -u "$console_user" /usr/bin/open -n /Applications/Unison.app || true
fi
exit 0
