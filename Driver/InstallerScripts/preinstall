#!/bin/sh
# Installer runs this script as root after the user's administrator approval.
console_user=$(/usr/bin/stat -f %Su /dev/console)
if [ "$console_user" != "root" ] && [ "$console_user" != "loginwindow" ]; then
    /usr/bin/killall -TERM -u "$console_user" Unison 2>/dev/null || true
    for attempt in 1 2 3 4 5; do
        if ! /usr/bin/pgrep -u "$console_user" -x Unison >/dev/null; then break; fi
        /bin/sleep 1
    done
    if /usr/bin/pgrep -u "$console_user" -x Unison >/dev/null; then
        echo "Unison kapanmadı; üzerine yazmadan kurulum durduruldu." >&2
        exit 1
    fi
fi
exit 0
